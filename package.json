    "@types/multer": "^2.0.0",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4",
